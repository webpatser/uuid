{
    "name": "webpatser/uuid",
    "description": "A pure PHP library to generate and validate universally unique identifiers (UUIDs) according to RFC 4122 and RFC 9562 standards. Support for UUID versions 1, 3, 4, 5, 6, 7, and 8.",
    "type": "library",
    "keywords": [
        "uuid",
        "rfc4122",
        "rfc9562",
        "identifier",
        "random",
        "guid"
    ],
    "homepage": "https://github.com/webpatser/uuid",
    "license": "MIT",
    "authors": [
        {
            "name": "Christoph Kempen",
            "email": "christoph@downsized.nl"
        }
    ],
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Webpatser\\Uuid\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webpatser\\Uuid\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
